{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:mvpeters": "pnpm --filter @website/mvpeters dev",
    "dev:spaced": "pnpm --filter @website/spaced dev",
    "build": "pnpm -r build",
    "build:mvpeters": "pnpm --filter @website/mvpeters build",
    "build:spaced": "pnpm --filter @website/spaced build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "playwright test",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "build:vercel": "NITRO_PRESET=vercel pnpm -r build"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
